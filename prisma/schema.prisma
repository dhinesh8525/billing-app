generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  email              String?
  phone              String?
  logo               String?
  gstin              String?
  pan                String?
  address            String?
  city               String?
  state              String?
  pincode            String?
  razorpayCustomerId String?
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt
  bankAccounts       BankAccount[]
  categories         Category[]
  invitations        Invitation[]
  invoices           Invoice[]
  parties            Party[]
  payments           Payment[]
  products           Product[]
  settings           Settings[]
  subscription       Subscription?
  memberships        TenantMembership[]
  // Restaurant POS relations
  floorPlans         FloorPlan[]
  tables             Table[]
  orders             Order[]
  kdsConfig          KDSConfig?
  kotReceipts        KOTReceipt[]
  recipes            Recipe[]
  billTransactions   BillTransaction[]

  @@index([slug])
  @@index([isActive])
}

model TenantMembership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      String   @default("MEMBER")
  isDefault Boolean  @default(false)
  joinedAt  DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
}

model Invitation {
  id        String   @id @default(cuid())
  email     String
  tenantId  String
  role      String   @default("MEMBER")
  token     String   @unique
  expiresAt DateTime
  invitedBy String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([email, tenantId])
  @@index([token])
  @@index([tenantId])
  @@index([email])
}

model Plan {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  description     String?
  price           Decimal        @db.Decimal(10, 2)
  billingInterval String         @default("MONTHLY")
  features        Json
  razorpayPlanId  String?        @unique
  isActive        Boolean        @default(true)
  isPopular       Boolean        @default(false)
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt
  subscriptions   Subscription[]

  @@index([isActive, sortOrder])
}

model Subscription {
  id                     String    @id @default(cuid())
  tenantId               String    @unique
  planId                 String
  status                 String    @default("TRIALING")
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelledAt            DateTime?
  razorpaySubscriptionId String?   @unique
  razorpayCustomerId     String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now()) @updatedAt
  plan                   Plan      @relation(fields: [planId], references: [id])
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([currentPeriodEnd])
}

model Payment {
  id                String   @id @default(cuid())
  tenantId          String
  subscriptionId    String?
  amount            Decimal  @db.Decimal(10, 2)
  currency          String   @default("INR")
  status            String
  razorpayPaymentId String?  @unique
  razorpayOrderId   String?
  razorpaySignature String?
  metadata          Json?
  failureReason     String?
  createdAt         DateTime @default(now())
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  name             String
  passwordHash     String?
  role             Role               @default(STAFF)
  isActive         Boolean            @default(true)
  lastLogin        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  image            String?
  accounts         Account[]
  invoices         Invoice[]
  memberships      TenantMembership[]
  orders           Order[]
  billTransactions BillTransaction[]

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, name])
  @@index([name])
}

model Product {
  id            String    @id @default(cuid())
  name          String
  sku           String    @unique
  barcode       String?   // EAN/UPC barcode for scanning
  description   String?
  price         Decimal   @db.Decimal(10, 2)
  costPrice     Decimal?  @db.Decimal(10, 2)
  stock         Int       @default(0)
  minStock      Int       @default(5)
  unit          String    @default("pcs")
  hsn           String?
  taxRate       Decimal?  @db.Decimal(5, 2)
  categoryId    String?
  isActive      Boolean   @default(true)
  isRawMaterial Boolean   @default(false) // For recipe management
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenantId      String
  category      Category? @relation(fields: [categoryId], references: [id])
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipe        Recipe?   // One-to-one with recipe

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, sku])
  @@index([tenantId, barcode])
  @@index([tenantId, isActive, name])
  @@index([tenantId, stock])
  @@index([tenantId, isRawMaterial])
  @@index([categoryId])
  @@index([isActive, name])
  @@index([name])
  @@index([sku])
  @@index([stock])
}

model Party {
  id              String    @id @default(cuid())
  name            String
  phone           String?   @unique
  email           String?
  gstin           String?
  pan             String?
  billingAddress  String?
  shippingAddress String?
  type            String    @default("customer")
  openingBalance  Decimal   @default(0) @db.Decimal(12, 2)
  currentBalance  Decimal   @default(0) @db.Decimal(12, 2)
  creditLimit     Decimal?  @db.Decimal(12, 2)
  creditDays      Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tenantId        String
  invoices        Invoice[]
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, type])
  @@index([tenantId, currentBalance])
  @@index([currentBalance])
  @@index([name])
  @@index([phone])
  @@index([type])
}

model Invoice {
  id               String            @id @default(cuid())
  invoiceNumber    String            @unique
  type             TransactionType   @default(SALE)
  status           InvoiceStatus     @default(DRAFT)
  partyId          String?
  customerName     String?
  customerPhone    String?
  customerEmail    String?
  subtotal         Decimal           @db.Decimal(12, 2)
  taxRate          Decimal           @db.Decimal(5, 2)
  cgst             Decimal           @default(0) @db.Decimal(10, 2)
  sgst             Decimal           @default(0) @db.Decimal(10, 2)
  igst             Decimal           @default(0) @db.Decimal(10, 2)
  taxAmount        Decimal           @db.Decimal(10, 2)
  discountPercent  Decimal           @default(0) @db.Decimal(5, 2)
  discountAmount   Decimal           @default(0) @db.Decimal(10, 2)
  roundOff         Decimal           @default(0) @db.Decimal(5, 2)
  total            Decimal           @db.Decimal(12, 2)
  amountPaid       Decimal           @default(0) @db.Decimal(12, 2)
  paymentMode      String?
  paymentStatus    String            @default("unpaid")
  notes            String?
  termsConditions  String?
  createdById      String
  invoiceDate      DateTime          @default(now())
  dueDate          DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tenantId         String
  createdBy        User              @relation(fields: [createdById], references: [id])
  party            Party?            @relation(fields: [partyId], references: [id])
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items            InvoiceItem[]
  orders           Order[]
  billTransactions BillTransaction[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, invoiceNumber])
  @@index([tenantId, type])
  @@index([tenantId, status])
  @@index([tenantId, invoiceDate])
  @@index([tenantId, createdAt])
  @@index([tenantId, paymentStatus])
  @@index([tenantId, type, status, invoiceDate])
  @@index([createdById])
  @@index([partyId])
  @@index([createdAt])
  @@index([invoiceDate])
  @@index([invoiceNumber])
  @@index([paymentStatus])
  @@index([status])
  @@index([type])
  @@index([type, status, invoiceDate])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  productId   String
  productName String
  productSku  String
  hsn         String?
  unit        String  @default("pcs")
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal @default(0) @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  lineTotal   Decimal @db.Decimal(10, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([productId])
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([tenantId, key])
  @@index([key])
}

model BankAccount {
  id            String   @id @default(cuid())
  name          String
  accountNumber String?
  bankName      String?
  ifsc          String?
  upiId         String?
  type          String   @default("bank")
  balance       Decimal  @default(0) @db.Decimal(12, 2)
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, isActive])
  @@index([isActive])
  @@index([type])
}

enum Role {
  ADMIN
  STAFF
}

enum InvoiceStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum TransactionType {
  SALE
  PURCHASE
  EXPENSE
  PAYMENT_IN
  PAYMENT_OUT
}

// Audit Log for tracking important actions
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  action     String   // CREATE, UPDATE, DELETE, LOGIN, etc.
  entityType String   // INVOICE, PRODUCT, USER, SUBSCRIPTION, etc.
  entityId   String?
  metadata   Json?    // Additional context (old values, new values, etc.)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@index([tenantId, entityType])
  @@index([tenantId, createdAt])
}

// Usage records for metering (monthly aggregates)
model UsageRecord {
  id        String   @id @default(cuid())
  tenantId  String
  metric    String   // INVOICES, PRODUCTS, USERS, API_CALLS
  count     Int      @default(0)
  period    String   // Format: YYYY-MM (e.g., "2024-01")
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([tenantId, metric, period])
  @@index([tenantId])
  @@index([tenantId, period])
  @@index([period])
}

// API Keys for public API access
model ApiKey {
  id          String    @id @default(cuid())
  tenantId    String
  name        String    // Friendly name for the key
  keyHash     String    @unique // SHA-256 hash of the actual key
  keyPrefix   String    // First 8 chars for identification (e.g., "sk_live_")
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  scopes      String[]  // ["read:products", "write:invoices", etc.]
  isActive    Boolean   @default(true)
  createdById String
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([tenantId])
  @@index([keyHash])
  @@index([tenantId, isActive])
}

// In-app notifications
model Notification {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String?   // If null, notification is for all tenant members
  type      String    // LOW_STOCK, PAYMENT_DUE, INVOICE_CREATED, etc.
  title     String
  message   String
  data      Json?     // Additional data (productId, invoiceId, etc.)
  priority  String    @default("normal") // low, normal, high, urgent
  isRead    Boolean   @default(false)
  readAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, userId])
  @@index([tenantId, isRead])
  @@index([createdAt])
  @@index([type])
}

// =============================================================================
// RESTAURANT POS MODELS
// =============================================================================

// Floor Plan for table layout management
model FloorPlan {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  layout    Json     // {width, height, gridSize}
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tables    Table[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// Restaurant tables
model Table {
  id          String      @id @default(cuid())
  tenantId    String
  floorPlanId String
  tableNumber String
  capacity    Int
  x           Int         // Position X on floor plan
  y           Int         // Position Y on floor plan
  shape       String      @default("square") // square, round, rectangle
  status      TableStatus @default(AVAILABLE)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  floorPlan   FloorPlan   @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@unique([tenantId, tableNumber])
  @@index([tenantId, status])
  @@index([floorPlanId])
}

// Orders for kitchen workflow (created before invoice)
model Order {
  id           String          @id @default(cuid())
  tenantId     String
  tableId      String?
  invoiceId    String?
  orderNumber  String
  orderType    OrderType       @default(DINE_IN)
  status       OrderStatus     @default(PENDING)
  specialNotes String?
  guestCount   Int             @default(1)
  createdById  String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  table        Table?          @relation(fields: [tableId], references: [id])
  invoice      Invoice?        @relation(fields: [invoiceId], references: [id])
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy    User            @relation(fields: [createdById], references: [id])
  items        OrderItem[]
  kotReceipts  KOTReceipt[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([tenantId, tableId])
  @@index([tenantId, createdAt])
  @@index([tableId])
  @@index([invoiceId])
}

// Order items with kitchen status tracking
model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  productId      String
  productName    String
  quantity       Int
  unitPrice      Decimal         @db.Decimal(10, 2)
  notes          String?
  status         OrderItemStatus @default(PENDING)
  servedQuantity Int             @default(0)
  kotNumber      String?
  station        String?         // KITCHEN, BAR, GRILL
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@index([orderId])
}

// Kitchen Display System configuration
model KDSConfig {
  id            String  @id @default(cuid())
  tenantId      String  @unique
  enableSound   Boolean @default(true)
  soundVolume   Int     @default(70)
  groupByTable  Boolean @default(false)
  printOnCreate Boolean @default(true)
  autoComplete  Int     @default(0) // Auto-complete after N minutes (0 = disabled)
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// KOT (Kitchen Order Ticket) receipts
model KOTReceipt {
  id          String    @id @default(cuid())
  tenantId    String
  orderId     String
  kotNumber   String
  station     String    // KITCHEN, BAR, GRILL
  printCount  Int       @default(1)
  printedAt   DateTime  @default(now())
  completedAt DateTime?
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kotNumber])
  @@index([tenantId, station])
  @@index([orderId])
}

// Recipe/BOM for food cost management
model Recipe {
  id          String             @id @default(cuid())
  tenantId    String
  productId   String             @unique
  name        String
  description String?
  prepTime    Int?               // Preparation time in minutes
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]

  @@index([tenantId])
}

// Recipe ingredients (BOM line items)
model RecipeIngredient {
  id            String  @id @default(cuid())
  recipeId      String
  rawMaterialId String  // Product ID with isRawMaterial=true
  quantity      Decimal @db.Decimal(10, 4)
  unit          String
  wastagePercent Decimal @default(0) @db.Decimal(5, 2)
  recipe        Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@index([rawMaterialId])
}

// Bill transaction history for split/merge tracking
model BillTransaction {
  id              String              @id @default(cuid())
  tenantId        String
  invoiceId       String
  transactionType BillTransactionType
  sourceInvoiceId String?
  targetInvoiceId String?
  itemIds         String[]            // Array of item IDs involved
  amount          Decimal             @db.Decimal(12, 2)
  reason          String?
  createdById     String
  createdAt       DateTime            @default(now())
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice         Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy       User                @relation(fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([invoiceId])
}

// =============================================================================
// RESTAURANT POS ENUMS
// =============================================================================

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  BILLING
  CLEANING
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum BillTransactionType {
  ORIGINAL
  SPLIT_SOURCE
  SPLIT_TARGET
  MERGE_SOURCE
  MERGE_TARGET
}
