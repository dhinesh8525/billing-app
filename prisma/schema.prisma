// Billing Application Database Schema
// Production-ready schema with proper indexing and relationships

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  ADMIN
  STAFF
}

enum InvoiceStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum TransactionType {
  SALE
  PURCHASE
  EXPENSE
  PAYMENT_IN
  PAYMENT_OUT
}

// ============================================================================
// USER MANAGEMENT
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String?   // Optional for OAuth users
  role          Role      @default(STAFF)
  isActive      Boolean   @default(true)
  image         String?   // Profile image from OAuth
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  invoices      Invoice[]
  accounts      Account[]

  @@index([email])
  @@index([role])
}

// OAuth Account linking (for Google, etc.)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ============================================================================
// PRODUCT MANAGEMENT
// ============================================================================

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
}

model Product {
  id          String    @id @default(cuid())
  name        String
  sku         String    @unique
  description String?
  price       Decimal   @db.Decimal(10, 2)
  costPrice   Decimal?  @db.Decimal(10, 2)  // Purchase price for profit calculation
  stock       Int       @default(0)
  minStock    Int       @default(5)         // Low stock alert threshold
  unit        String    @default("pcs")     // Unit: pcs, kg, ltr, box, etc.
  hsn         String?                       // HSN/SAC code for GST compliance
  taxRate     Decimal?  @db.Decimal(5, 2)   // Item-specific GST rate (overrides default)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  isActive    Boolean   @default(true)      // Soft delete flag
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
  @@index([sku])
  @@index([categoryId])
  @@index([isActive, name])  // Composite index for active product search
  @@index([stock])           // For low stock queries
}

// ============================================================================
// PARTY (CUSTOMER/SUPPLIER) MANAGEMENT
// ============================================================================

model Party {
  id              String    @id @default(cuid())
  name            String
  phone           String?   @unique
  email           String?
  gstin           String?                      // GST Identification Number
  pan             String?                      // PAN for compliance
  billingAddress  String?
  shippingAddress String?
  type            String    @default("customer") // customer, supplier, both
  openingBalance  Decimal   @db.Decimal(12, 2) @default(0)
  currentBalance  Decimal   @db.Decimal(12, 2) @default(0) // Positive = receivable, Negative = payable
  creditLimit     Decimal?  @db.Decimal(12, 2)
  creditDays      Int       @default(0)        // Payment terms
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  invoices        Invoice[]

  @@index([name])
  @@index([phone])
  @@index([type])
  @@index([currentBalance])  // For receivables/payables queries
}

// ============================================================================
// INVOICE/BILLING
// ============================================================================

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  type            TransactionType @default(SALE)
  status          InvoiceStatus @default(DRAFT)

  // Party linkage (optional for walk-in customers)
  partyId         String?
  party           Party?        @relation(fields: [partyId], references: [id])

  // Walk-in customer info (when no party linked)
  customerName    String?
  customerPhone   String?
  customerEmail   String?

  // Pricing snapshot (immutable after completion)
  subtotal        Decimal       @db.Decimal(12, 2)
  taxRate         Decimal       @db.Decimal(5, 2)   // Default GST rate applied
  cgst            Decimal       @db.Decimal(10, 2)  @default(0)
  sgst            Decimal       @db.Decimal(10, 2)  @default(0)
  igst            Decimal       @db.Decimal(10, 2)  @default(0)
  taxAmount       Decimal       @db.Decimal(10, 2)
  discountPercent Decimal       @db.Decimal(5, 2)   @default(0)
  discountAmount  Decimal       @db.Decimal(10, 2)  @default(0)
  roundOff        Decimal       @db.Decimal(5, 2)   @default(0)
  total           Decimal       @db.Decimal(12, 2)

  // Payment tracking
  amountPaid      Decimal       @db.Decimal(12, 2)  @default(0)
  paymentMode     String?       // cash, upi, card, bank_transfer, credit
  paymentStatus   String        @default("unpaid")  // paid, unpaid, partial

  // Metadata
  notes           String?
  termsConditions String?
  createdById     String
  createdBy       User          @relation(fields: [createdById], references: [id])
  invoiceDate     DateTime      @default(now())
  dueDate         DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           InvoiceItem[]

  @@index([invoiceNumber])
  @@index([type])
  @@index([status])
  @@index([invoiceDate])
  @@index([createdAt])
  @@index([createdById])
  @@index([partyId])
  @@index([paymentStatus])
  @@index([type, status, invoiceDate])  // Composite for dashboard queries
}

model InvoiceItem {
  id           String  @id @default(cuid())
  invoiceId    String
  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // SNAPSHOT: Product data at time of billing (immutable)
  productId    String  // Reference for reporting/analytics
  productName  String
  productSku   String
  hsn          String?
  unit         String  @default("pcs")
  unitPrice    Decimal @db.Decimal(10, 2)
  quantity     Int
  taxRate      Decimal @db.Decimal(5, 2) @default(0)
  taxAmount    Decimal @db.Decimal(10, 2) @default(0)
  discount     Decimal @db.Decimal(10, 2) @default(0)
  lineTotal    Decimal @db.Decimal(10, 2)

  @@index([invoiceId])
  @@index([productId])
}

// ============================================================================
// SETTINGS & CONFIGURATION
// ============================================================================

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@index([key])
}

// ============================================================================
// CASH & BANK MANAGEMENT
// ============================================================================

model BankAccount {
  id            String   @id @default(cuid())
  name          String
  accountNumber String?
  bankName      String?
  ifsc          String?
  upiId         String?
  type          String   @default("bank")  // cash, bank, upi
  balance       Decimal  @db.Decimal(12, 2) @default(0)
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type])
  @@index([isActive])
}
